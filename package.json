{
  "name": "musee-imaginaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/clean-appledouble.mjs && node node_modules/next/dist/bin/next dev",
    "build": "node scripts/clean-appledouble.mjs && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "art:fetch": "node --experimental-strip-types --no-warnings scripts/fetch-artworks.mjs",
    "art:process": "node --experimental-strip-types --no-warnings scripts/process-artworks.mjs",
    "art:report": "node --experimental-strip-types --no-warnings scripts/credits-report.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  }
}
